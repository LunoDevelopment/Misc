<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Window Colors -->

    <Color x:Key="PrimaryWindowColor">#091018</Color>
    <Color x:Key="SecondaryWindowColor">#CC111D2B</Color>
    <Color x:Key="TertiaryWindowColor">#CC182A3D</Color>
    <Color x:Key="PrimaryDropShadowColor">#6CCBFF</Color>

    <Color x:Key="PrimaryForegroundColor1">#E7F5FF</Color>
    <Color x:Key="PrimaryForegroundColor2">#B6D0E0</Color>

    <Color x:Key="SecondaryForegroundColor1">#FFFFFF</Color>
    <Color x:Key="SecondaryForegroundColor2">#D6EAF5</Color>

    <Color x:Key="TertiaryForegroundColor1">#6CCBFF</Color>
    <Color x:Key="TertiaryForegroundColor2">#B08CFF</Color>

    <Color x:Key="DarkForegroundColor1">#60727F</Color>
    <Color x:Key="DarkForegroundColor2">#3E4C57</Color>

    <Color x:Key="WindowBorderColor">#293C4D</Color>

    <Color x:Key="AccentColor1">#6CCBFF</Color>
    <Color x:Key="AccentColor2">#398BFF</Color>

    <!-- Base Primary Button Colors -->

    <Color x:Key="PrimaryButtonColor">#CC142230</Color>
    <Color x:Key="PrimaryButtonHoverColor">#DD1C3044</Color>
    <Color x:Key="PrimaryButtonPressColor">#EE26405A</Color>

    <Color x:Key="PrimaryButtonBorderColor">#30485C</Color>
    <Color x:Key="PrimaryButtonHoverBorderColor">#427CA5</Color>
    <Color x:Key="PrimaryButtonPressBorderColor">#6CCBFF</Color>

    <!-- Base Secondary Button Colors -->

    <Color x:Key="SecondaryButtonColor">#B3091018</Color>
    <Color x:Key="SecondaryButtonHoverColor">#D3142638</Color>
    <Color x:Key="SecondaryButtonPressColor">#FF1B3045</Color>

    <Color x:Key="SecondaryButtonBorderColor">#30485C</Color>
    <Color x:Key="SecondaryButtonHoverBorderColor">#427CA5</Color>
    <Color x:Key="SecondaryButtonPressBorderColor">#6CCBFF</Color>

    <!-- Base Close Button Colors -->

    <Color x:Key="CloseButtonColor">#00000000</Color>
    <Color x:Key="CloseButtonHoverColor">#FF5268</Color>
    <Color x:Key="CloseButtonPressColor">#E8324B</Color>

    <Color x:Key="CloseButtonBorderColor">#00000000</Color>
    <Color x:Key="CloseButtonHoverBorderColor">#FF7587</Color>
    <Color x:Key="CloseButtonPressBorderColor">#FF2945</Color>

    <!-- Base Control Button Colors -->

    <Color x:Key="ControlButtonColor">#00000000</Color>
    <Color x:Key="ControlButtonHoverColor">#DD1C3044</Color>
    <Color x:Key="ControlButtonPressColor">#EE26405A</Color>

    <Color x:Key="ControlButtonBorderColor">#00000000</Color>
    <Color x:Key="ControlButtonHoverBorderColor">#30485C</Color>
    <Color x:Key="ControlButtonPressBorderColor">#427CA5</Color>

    <!-- Base Logo Button Colors -->

    <Color x:Key="LogoButtonColor">#00000000</Color>
    <Color x:Key="LogoButtonHoverColor">#336CCBFF</Color>
    <Color x:Key="LogoButtonPressColor">#666CCBFF</Color>

    <Color x:Key="LogoButtonBorderColor">#00000000</Color>
    <Color x:Key="LogoButtonHoverBorderColor">#666CCBFF</Color>
    <Color x:Key="LogoButtonPressBorderColor">#996CCBFF</Color>

    <!-- Base Page Button Colors -->

    <Color x:Key="PageButtonColor">#00000000</Color>
    <Color x:Key="PageButtonHoverColor">#DD1C3044</Color>
    <Color x:Key="PageButtonPressColor">#EE26405A</Color>
    <Color x:Key="PageButtonDisabledColor">#66398BFF</Color>

    <Color x:Key="PageButtonBorderColor">#00000000</Color>
    <Color x:Key="PageButtonHoverBorderColor">#6630485C</Color>
    <Color x:Key="PageButtonPressBorderColor">#9930485C</Color>
    <Color x:Key="PageButtonDisabledBorderColor">#398BFF</Color>

    <!-- ScriptHub Button -->

    <Color x:Key="ScriptHubButtonColor">#CC142230</Color>
    <Color x:Key="ScriptHubButtonHoverColor">#DD1C3044</Color>
    <Color x:Key="ScriptHubButtonPressColor">#EE26405A</Color>

    <Color x:Key="ScriptHubButtonBorderColor">#293C4D</Color>
    <Color x:Key="ScriptHubButtonHoverBorderColor">#427CA5</Color>
    <Color x:Key="ScriptHubButtonPressBorderColor">#6CCBFF</Color>

    <!-- Base Status Colors -->

    <Color x:Key="OnlineColor">#48E6B1</Color>
    <Color x:Key="OfflineColor">#FF5C70</Color>


    <!-- Window Brushes -->
    <SolidColorBrush x:Key="PrimaryWindowBrush"
         Color="{DynamicResource PrimaryWindowColor}" />
    <SolidColorBrush x:Key="SecondaryWindowBrush"
         Color="{DynamicResource SecondaryWindowColor}" />
    <SolidColorBrush x:Key="TertiaryWindowBrush"
         Color="{DynamicResource TertiaryWindowColor}" />
    <SolidColorBrush x:Key="PrimaryDropShadowBrush"
         Color="{DynamicResource PrimaryDropShadowColor}" />
    <SolidColorBrush x:Key="AccentBrush1"
         Color="{DynamicResource AccentColor1}" />
    <SolidColorBrush x:Key="AccentBrush2"
         Color="{DynamicResource AccentColor2}" />

    <LinearGradientBrush x:Key="AccentGradientBrush" 
                 StartPoint="0,0"
                 EndPoint="0,1">
        <GradientStop Color="{DynamicResource AccentColor1}" Offset="0" />
        <GradientStop Color="{DynamicResource AccentColor2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryForegroundBrush" 
                     StartPoint="0,0"
                     EndPoint="0,1">
        <GradientStop Color="{DynamicResource PrimaryForegroundColor1}" Offset="0" />
        <GradientStop Color="{DynamicResource PrimaryForegroundColor2}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryForegroundBrush"
                     StartPoint="0,0"
                     EndPoint="0,1">
        <GradientStop Color="{DynamicResource SecondaryForegroundColor1}" Offset="0" />
        <GradientStop Color="{DynamicResource SecondaryForegroundColor2}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TertiaryForegroundBrush"
                     StartPoint="0,0"
                     EndPoint="0,1">
        <GradientStop Color="{DynamicResource TertiaryForegroundColor1}" Offset="0" />
        <GradientStop Color="{DynamicResource TertiaryForegroundColor2}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DarkForegroundBrush"
                     StartPoint="0,0"
                     EndPoint="0,1">
        <GradientStop Color="{DynamicResource DarkForegroundColor1}" Offset="0" />
        <GradientStop Color="{DynamicResource DarkForegroundColor2}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBorderBrush"
         Color="{DynamicResource WindowBorderColor}" />

    <!-- Primary Button Brushes -->
    <SolidColorBrush x:Key="PrimaryButtonBrush"
         Color="{DynamicResource PrimaryButtonColor}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush"
         Color="{DynamicResource PrimaryButtonHoverColor}" />
    <SolidColorBrush x:Key="PrimaryButtonPressBrush"
         Color="{DynamicResource PrimaryButtonPressColor}" />

    <SolidColorBrush x:Key="PrimaryButtonBorderBrush"
         Color="{DynamicResource PrimaryButtonBorderColor}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBorderBrush"
         Color="{DynamicResource PrimaryButtonHoverBorderColor}" />
    <SolidColorBrush x:Key="PrimaryButtonPressBorderBrush"
         Color="{DynamicResource PrimaryButtonPressBorderColor}" />

    <!-- Secondary Button Brushes -->
    <SolidColorBrush x:Key="SecondaryButtonBrush"
         Color="{DynamicResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush"
         Color="{DynamicResource SecondaryButtonHoverColor}" />
    <SolidColorBrush x:Key="SecondaryButtonPressBrush"
         Color="{DynamicResource SecondaryButtonPressColor}" />

    <SolidColorBrush x:Key="SecondaryButtonBorderBrush"
         Color="{DynamicResource SecondaryButtonBorderColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBorderBrush"
         Color="{DynamicResource SecondaryButtonHoverBorderColor}" />
    <SolidColorBrush x:Key="SecondaryButtonPressBorderBrush"
         Color="{DynamicResource SecondaryButtonPressBorderColor}" />

    <!-- Logo Button Brushes -->
    <SolidColorBrush x:Key="LogoButtonBrush"
         Color="{DynamicResource LogoButtonColor}" />
    <SolidColorBrush x:Key="LogoButtonHoverBrush"
         Color="{DynamicResource LogoButtonHoverColor}" />
    <SolidColorBrush x:Key="LogoButtonPressBrush"
         Color="{DynamicResource LogoButtonPressColor}" />

    <SolidColorBrush x:Key="LogoButtonBorderBrush"
         Color="{DynamicResource LogoButtonBorderColor}" />
    <SolidColorBrush x:Key="LogoButtonHoverBorderBrush"
         Color="{DynamicResource LogoButtonHoverBorderColor}" />
    <SolidColorBrush x:Key="LogoButtonPressBorderBrush"
         Color="{DynamicResource LogoButtonPressBorderColor}" />

    <!-- Page Button Brushes -->
    <SolidColorBrush x:Key="PageButtonBrush"
         Color="{DynamicResource PageButtonColor}" />
    <SolidColorBrush x:Key="PageButtonHoverBrush"
         Color="{DynamicResource PageButtonHoverColor}" />
    <SolidColorBrush x:Key="PageButtonPressBrush"
         Color="{DynamicResource PageButtonPressColor}" />
    <SolidColorBrush x:Key="PageButtonDisabledBrush"
         Color="{DynamicResource PageButtonDisabledColor}" />

    <SolidColorBrush x:Key="PageButtonBorderBrush"
         Color="{DynamicResource PageButtonBorderColor}" />
    <SolidColorBrush x:Key="PageButtonHoverBorderBrush"
         Color="{DynamicResource PageButtonHoverBorderColor}" />
    <SolidColorBrush x:Key="PageButtonPressBorderBrush"
         Color="{DynamicResource PageButtonPressBorderColor}" />
    <SolidColorBrush x:Key="PageButtonDisabledBorderBrush"
         Color="{DynamicResource PageButtonDisabledBorderColor}" />

    <!-- Close Button Brushes -->
    <SolidColorBrush x:Key="CloseButtonBrush"
         Color="{DynamicResource CloseButtonColor}" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush"
         Color="{DynamicResource CloseButtonHoverColor}" />
    <SolidColorBrush x:Key="CloseButtonPressBrush"
         Color="{DynamicResource CloseButtonPressColor}" />

    <SolidColorBrush x:Key="CloseButtonBorderBrush"
         Color="{DynamicResource CloseButtonBorderColor}" />
    <SolidColorBrush x:Key="CloseButtonHoverBorderBrush"
         Color="{DynamicResource CloseButtonHoverBorderColor}" />
    <SolidColorBrush x:Key="CloseButtonPressBorderBrush"
         Color="{DynamicResource CloseButtonPressBorderColor}" />

    <!-- Control Button Brushes -->
    <SolidColorBrush x:Key="ControlButtonBrush"
         Color="{DynamicResource ControlButtonColor}" />
    <SolidColorBrush x:Key="ControlButtonHoverBrush"
         Color="{DynamicResource ControlButtonHoverColor}" />
    <SolidColorBrush x:Key="ControlButtonPressBrush"
         Color="{DynamicResource ControlButtonPressColor}" />

    <SolidColorBrush x:Key="ControlButtonBorderBrush"
         Color="{DynamicResource ControlButtonBorderColor}" />
    <SolidColorBrush x:Key="ControlButtonHoverBorderBrush"
         Color="{DynamicResource ControlButtonHoverBorderColor}" />
    <SolidColorBrush x:Key="ControlButtonPressBorderBrush"
         Color="{DynamicResource ControlButtonPressBorderColor}" />

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="OnlineBrush"
         Color="{DynamicResource OnlineColor}" />
    <SolidColorBrush x:Key="OfflineBrush"
         Color="{DynamicResource OfflineColor}" />

</ResourceDictionary>